    def cambiar_modo(self, label):
        self.modo_control = label
        self.error_integral = np.array([0.0, 0.0])
        self.dq = np.array([0.0, 0.0])

    def actualizar_estado_estatico(self):
        M, G = self.calcular_dinamica(self.q)
        self.actualizar_graficos(M, G, error=np.array([0.,0.]), tau=G)

    def loop_simulacion(self, frame):
        if not self.ejecutando:
            return self.brazo_dibujo,
            
        # MÁQUINA DE ESTADOS PARA VERIFICACIÓN Y TRAYECTORIA CORRECTIVA
        xs_actual, ys_actual = self.fk(self.q[0], self.q[1])
        x_efector, y_efector = xs_actual[2], ys_actual[2]

        if self.estado_Waypoint == 'MOVIENDO':
            if len(self.trayectoria_qd) > 0:
                self.q_d = self.trayectoria_qd.pop(0)
                xs_id, ys_id = self.fk(self.q_d[0], self.q_d[1])
                self.historial_x_ideal.append(xs_id[2])
                self.historial_y_ideal.append(ys_id[2])
                self.linea_ideal.set_data(self.historial_x_ideal, self.historial_y_ideal)
            else:
                # Terminó la trayectoria planeada para este punto, pasar a verificación
                self.estado_Waypoint = 'VERIFICANDO'
                self.contador_espera_verificacion = 15 # Ciclos de asentamiento para verificar

        elif self.estado_Waypoint == 'VERIFICANDO':
            if self.contador_espera_verificacion > 0:
                self.contador_espera_verificacion -= 1
            else:
                # Obtener la posición deseada en cartesiano del waypoint actual
                wp_objetivo = self.puntos_cartesianos[self.indice_punto_actual]
                distancia = np.sqrt((x_efector - wp_objetivo[0])**2 + (y_efector - wp_objetivo[1])**2)

                if distancia <= self.tolerancia_waypoint:
                    # ¡Waypoint tocado exitosamente! Pasar al siguiente punto
                    self.textos_eq['wp_status'].set_text(f"WP {self.indice_punto_actual+1}: ¡TOCADO OK! (d={distancia:.2f}m)")
                    self.textos_eq['wp_status'].set_color('green')
                    self.indice_punto_actual += 1
                    
                    if self.indice_punto_actual < len(self.puntos_guardados):
                        # Cargar siguiente segmento
                        self.generar_trayectoria_segmento(self.puntos_guardados[self.indice_punto_actual-1], self.puntos_guardados[self.indice_punto_actual])
                        self.estado_Waypoint = 'MOVIENDO'
                    else:
                        self.ejecutando = False
                        self.textos_eq['wp_status'].set_text("¡Todos los Waypoints completados!")
                else:
                    # NO lo tocó: Activar estado correctivo
                    self.textos_eq['wp_status'].set_text(f"WP {self.indice_punto_actual+1} NO TOCADO (d={distancia:.2f}m). Corrigiendo...")
                    self.textos_eq['wp_status'].set_color('red')
                    self.estado_Waypoint = 'CORRIGIENDO'

        elif self.estado_Waypoint == 'CORRIGIENDO':
            # Generar trayectoria correctiva directa hacia el waypoint no alcanzado
            wp_objetivo_ang = self.puntos_guardados[self.indice_punto_actual]
            pasos_correccion = 30
            t1_corr = np.linspace(self.q[0], wp_objetivo_ang[0], pasos_correccion)
            t2_corr = np.linspace(self.q[1], wp_objetivo_ang[1], pasos_correccion)
            
            self.trayectoria_qd = [np.array([t1, t2]) for t1, t2 in zip(t1_corr, t2_corr)]
            self.estado_Waypoint = 'MOVIENDO'

        # LECTURA DE ESTADOS DE SENSORES (PASO 1: FALLA SENSOR)
        dq_medida = np.array([0.0, 0.0]) if self.falla_sensor else self.dq

        # LEYES DE CONTROL
        error = self.q_d - self.q
        derror = 0.0 - dq_medida
        self.error_integral += error * dt
        
        M, G = self.calcular_dinamica(self.q)
        tau = np.array([0.0, 0.0])

        if self.modo_control == 'PID':
            u_pid = Kp * error + Kd * derror + Ki * self.error_integral
            tau = u_pid
            
        elif self.modo_control == 'PID + Feedforward':
            u_pid = Kp * error + Kd * derror + Ki * self.error_integral
            _, G_deseada = self.calcular_dinamica(self.q_d)
            tau = u_pid + G_deseada
            
        elif self.modo_control == 'Ackermann u=-Kx':
            x_estado = np.array([error[0], derror[0]])
            u_ack = self.K_ackermann @ x_estado
            tau = np.array([u_ack[0], Kp * error[1] + Kd * derror[1]]) + G

        elif self.modo_control == 'Cinemático con RNA':
            xs_id, ys_id = self.fk(self.q_d[0], self.q_d[1])
            pred_q = self.rna_model.predict([[xs_id[2], ys_id[2]]])[0]
            self.q = np.copy(pred_q)
            self.dq = np.array([0.0, 0.0])

        # APLICACIÓN DE FALLA EN ACTUADOR M2 (PASO 2: FALLA M2)
        if self.falla_m2:
            tau[1] = 0.0  # Pérdida total de torque en el codo

        # INTEGRACIÓN DINÁMICA DE LA PLANTA
        if self.modo_control != 'Cinemático con RNA':
            ddq = np.linalg.inv(M).dot(tau - G)
            self.dq += ddq * dt
            self.q += self.dq * dt

        self.actualizar_graficos(M, G, error, tau)
        return self.linea_real, self.brazo_dibujo, self.polos_plot

    def generar_trayectoria_segmento(self, q_inicio, q_fin):
        pasos = 40
        t1_t = np.linspace(q_inicio[0], q_fin[0], pasos)
        t2_t = np.linspace(q_inicio[1], q_fin[1], pasos)
        self.trayectoria_qd = [np.array([t1, t2]) for t1, t2 in zip(t1_t, t2_t)]

    def actualizar_graficos(self, M, G, error, tau):
        xs, ys = self.fk(self.q[0], self.q[1])
        self.brazo_dibujo.set_data(xs, ys)
        
        if self.ejecutando:
            self.historial_x_real.append(xs[2])
            self.historial_y_real.append(ys[2])
            if len(self.historial_x_real) > 150:
                self.historial_x_real.pop(0)
                self.historial_y_real.pop(0)
            self.linea_real.set_data(self.historial_x_real, self.historial_y_real)

        # Diagnóstico matricial continuo
        r_wc, r_wo, _, _ = self.analizar_propiedades_sistema()
        
        status_wo = f"Paso 1 - Observabilidad (Wo): Rango = {r_wo}/4 "
        status_wo += "(OBSERVABLE)" if r_wo == 4 else "(PERDIDA DE INF.)"
        self.textos_eq['wo_status'].set_text(status_wo)
        self.textos_eq['wo_status'].set_color('green' if r_wo == 4 else 'orange')
        
        status_wc = f"Paso 2 - Controlabilidad (Wc): Rango = {r_wc}/4 "
        status_wc += "(CONTROLABLE)" if r_wc == 4 else "(SUBACTUADO / NO CONTROLABLE)"
        self.textos_eq['wc_status'].set_text(status_wc)
        self.textos_eq['wc_status'].set_color('green' if r_wc == 4 else 'red')

        # Plano Z
        A_cont = np.array([[0.0, 1.0], [-Kp / M[0,0], -Kd / M[0,0]]])
        sys_cont = signal.StateSpace(A_cont, [[0],[1]], [[1, 0]], [[0]])
        polos_z = np.linalg.eigvals(sys_cont.to_discrete(dt).A)
        self.polos_plot.set_data(polos_z.real, polos_z.imag)
        
        # Textos de estado
        q1_deg, q2_deg = np.degrees(self.q[0]), np.degrees(self.q[1])
        self.textos_eq['q'].set_text(f"= [{q1_deg:.1f}°, {q2_deg:.1f}°]^T")
        self.textos_eq['fk'].set_text(f"x={xs[2]:.2f}m, y={ys[2]:.2f}m")
        self.textos_eq['M11'].set_text(f"Inercia M11: {M[0,0]:.2f} kg*m²")
        self.textos_eq['G'].set_text(f"Gravedad G: [{G[0]:.1f}, {G[1]:.1f}] Nm")

        self.textos_eq['diag_qd'].set_text(f"qd=[{np.degrees(self.q_d[0]):.1f}°,\n{np.degrees(self.q_d[1]):.1f}°]")
        self.textos_eq['diag_tau'].set_text(f"Tau=[{tau[0]:.1f},\n{tau[1]:.1f}]")
        self.textos_eq['diag_q'].set_text(f"q=[{np.degrees(self.q[0]):.1f}°,\n{np.degrees(self.q[1]):.1f}°]")

    def al_clic(self, event):
        if event.inaxes == self.ax_robot:
            t1, t2 = self.ik(event.xdata, event.ydata)
            if t1 is not None:
                self.puntos_guardados.append((t1, t2))
                self.puntos_cartesianos.append((event.xdata, event.ydata))
                m, = self.ax_robot.plot(event.xdata, event.ydata, 'g.', markersize=10)
                t = self.ax_robot.text(event.xdata+0.2, event.ydata+0.2, str(len(self.puntos_guardados)), color='green')
                self.marcadores_puntos.extend([m, t])
                self.fig.canvas.draw_idle()

    def ejecutar(self, event):
        if not self.puntos_guardados: return
        self.indice_punto_actual = 0
        self.generar_trayectoria_segmento(self.q, self.puntos_guardados[0])
        self.estado_Waypoint = 'MOVIENDO'
        self.ejecutando = True

    def limpiar(self, event):
        self.ejecutando = False
        self.puntos_guardados.clear()
        self.puntos_cartesianos.clear()
        self.trayectoria_qd.clear()
        self.historial_x_real.clear()
        self.historial_y_real.clear()
        self.historial_x_ideal.clear()
        self.historial_y_ideal.clear()
        self.historial_x_rna.clear()
        self.historial_y_rna.clear()
        self.indice_punto_actual = 0
        self.estado_Waypoint = 'ESPERANDO'
        
        for m in self.marcadores_puntos:
            try: m.remove()
            except: pass
        self.marcadores_puntos.clear()
        
        self.linea_ideal.set_data([], [])
        self.linea_real.set_data([], [])
        self.linea_rna.set_data([], [])
        
        self.q_d = np.copy(self.q)
        self.dq = np.array([0.0, 0.0])
        self.error_integral = np.array([0.0, 0.0])
        self.textos_eq['wp_status'].set_text("Estado Waypoint: INACTIVO")
        self.textos_eq['wp_status'].set_color('purple')
        
        self.actualizar_estado_estatico()
        self.fig.canvas.draw_idle()

